###############################################################################
# 10. CMS YÖNETİM PORTALI & ARAMA (ADMIN CMS - PERF-01 GIN & SEC-02 RE-DOS GUARD)
###############################################################################

### 🟢 10.1 CMS Medya Listesi (Admin - Sayfalanmış)
# Beklenen: 200 OK -> AdminMediaListResponse (Tüm film ve dizilerin ham dökümü)
GET {{Gateway_HostAddress}}/api/catalog/admin/media?page=1&pageSize=10
Authorization: Bearer {{AdminToken}}
Accept: application/json

### 🟢 10.2 Leading Wildcard Arama (PERF-01: GIN Trigram İndeks Hızlandırması)
# Beklenen: 200 OK -> "Başlangıç" kelimesini içeren medya kayıtları milisaniyeler içinde döner
GET {{Gateway_HostAddress}}/api/catalog/admin/media?search=Ba%C5%9Flang%C4%B1%C3%A7
Authorization: Bearer {{AdminToken}}
Accept: application/json

### 🟢 10.3 Medya Türü Filtresi: Sadece Filmler (MediaType=1)
# Beklenen: 200 OK -> Yalnızca Film türündeki kayıtlar listelenir
GET {{Gateway_HostAddress}}/api/catalog/admin/media?mediaType=1
Authorization: Bearer {{AdminToken}}
Accept: application/json

### 🟢 10.4 Medya Türü Filtresi: Sadece Diziler (MediaType=2)
# Beklenen: 200 OK -> Yalnızca Dizi türündeki kayıtlar listelenir
GET {{Gateway_HostAddress}}/api/catalog/admin/media?mediaType=2
Authorization: Bearer {{AdminToken}}
Accept: application/json

### 🔴 10.5 SEC-02 DoS / ReDoS Koruması: Arama Parametresi > 100 Karakter Doğrulaması
# Beklenen: 400 Bad Request -> "Arama ifadesi en fazla 100 karakter olabilir."
GET {{Gateway_HostAddress}}/api/catalog/admin/media?search=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
Authorization: Bearer {{AdminToken}}
Accept: application/json
