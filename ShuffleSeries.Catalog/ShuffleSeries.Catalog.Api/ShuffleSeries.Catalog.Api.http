@Gateway_HostAddress = http://localhost:5001
@Catalog_HostAddress = http://localhost:5010

# Dynamic Test IDs (Oluşturma isteklerinden dönen GUID'leri buraya yapıştırabilirsiniz)
@MovieId = 00000000-0000-0000-0000-000000000000
@SeriesId = 00000000-0000-0000-0000-000000000000
@EpisodeId = 00000000-0000-0000-0000-000000000000
@PlatformId = 00000000-0000-0000-0000-000000000000
@MoodId = 00000000-0000-0000-0000-000000000000
@GenreId = 00000000-0000-0000-0000-000000000000

# Pre-Generated JWT Tokens (HMAC-SHA256, HashiCorp Vault 'Jwt:Secret' ile imzalı, geçerlilik: 2033)
@AdminToken = eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9..CykdjVV5C-ykh6lEoFaUueCtvVY0H-Ov2UeUIwDHeTk
@GuestToken = eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9..03CRLu4fqT8uEPQ-AI8F0SMEGCa1e1DVnVvxFDrEv1w

###############################################################################
# 1. SAĞLIK KONTROLLERİ (HEALTH PROBES)
###############################################################################

### 🟢 1.1 Gateway Liveness Probe
# Beklenen: 200 OK -> {"status":"Healthy","type":"Liveness",...}
GET {{Gateway_HostAddress}}/health/live
Accept: application/json

### 🟢 1.2 Gateway Readiness Probe (Redis vb. bağımlılıklar)
# Beklenen: 200 OK -> {"status":"Healthy","type":"Readiness",...}
GET {{Gateway_HostAddress}}/health/ready
Accept: application/json

### 🟢 1.3 Gateway Üzerinden Catalog Liveness Probe
# Beklenen: 200 OK -> YARP reverse proxy üzerinden catalog-api /health/live
GET {{Gateway_HostAddress}}/catalog-api/health/live
Accept: application/json

### 🟢 1.4 Gateway Üzerinden Catalog Readiness Probe
# Beklenen: 200 OK -> YARP reverse proxy üzerinden catalog-api (PostgreSQL, Vault, RabbitMQ)
GET {{Gateway_HostAddress}}/catalog-api/health/ready
Accept: application/json

### 🟢 1.5 Doğrudan Catalog Liveness Probe
# Beklenen: 200 OK
GET {{Catalog_HostAddress}}/health/live
Accept: application/json

### 🟢 1.6 Doğrudan Catalog Readiness Probe
# Beklenen: 200 OK
GET {{Catalog_HostAddress}}/health/ready
Accept: application/json


###############################################################################
# 2. GÜVENLİK & YETKİLENDİRME (EDGE AUTHENTICATION & PBAC)
###############################################################################

### 🔴 2.1 Tokensiz İstek (Missing Authorization Header)
# Beklenen: 401 Unauthorized (YARP Edge Authentication koruması)
GET {{Gateway_HostAddress}}/api/catalog/admin/media
Accept: application/json

### 🔴 2.2 Bozuk / Geçersiz Formatlı Token (Malformed Bearer)
# Beklenen: 401 Unauthorized
GET {{Gateway_HostAddress}}/api/catalog/admin/media
Authorization: Bearer not_a_valid_jwt_token_format
Accept: application/json

### 🔴 2.3 Süresi Dolmuş Token (Expired JWT)
# Beklenen: 401 Unauthorized (ClockSkew = Zero)
GET {{Gateway_HostAddress}}/api/catalog/admin/media
Authorization: Bearer eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9.eyJpc3MiOiAiU2h1ZmZsZVNlcmllcy5JZGVudGl0eSIsICJleHAiOiAxNjAwMDAwMDAwfQ.invalid
Accept: application/json

### 🔴 2.4 İmzası Tahrif Edilmiş Token (Tampered Signature)
# Beklenen: 401 Unauthorized (HMAC-SHA256 signature verification failed)
GET {{Gateway_HostAddress}}/api/catalog/admin/media
Authorization: Bearer eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9.eyJpc3MiOiAiU2h1ZmZsZVNlcmllcy5JZGVudGl0eSIsICJleHAiOiAxOTk5OTk5OTk5fQ.tampered_signature_payload_xyz
Accept: application/json

### 🔴 2.5 Standart Kullanıcı Admin Endpoint'ine Erişim (Policy Reddi)
# Beklenen: 403 Forbidden (GuestToken kullanıcısında 'catalog:admin-media:read' yetkisi yoktur)
GET {{Gateway_HostAddress}}/api/catalog/admin/media
Authorization: Bearer {{GuestToken}}
Accept: application/json

### 🔴 2.6 Standart Kullanıcı Film Oluşturma Denemesi (PBAC Reddi)
# Beklenen: 403 Forbidden (GuestToken kullanıcısında 'catalog:movies:create' yetkisi yoktur)
POST {{Gateway_HostAddress}}/api/catalog/movies
Authorization: Bearer {{GuestToken}}
Content-Type: application/json

{
  "releaseYear": 2024,
  "runtimeMinutes": 120,
  "posterUrl": "https://example.com/poster.jpg",
  "languageCode": "tr",
  "title": "Yetkisiz Ekleme Denemesi"
}


###############################################################################
# 3. PLATFORMLAR TAKSONOMİSİ (TAXONOMY - PLATFORMS CRUD & CACHING)
###############################################################################

### 🟢 3.1 Aktif Platformları Listeleme (Read-Through Cache)
# Beklenen: 200 OK -> IReadOnlyList<PlatformResponse>
GET {{Gateway_HostAddress}}/api/catalog/platforms
Authorization: Bearer {{GuestToken}}
Accept: application/json

### 🟢 3.2 Yeni Platform Ekleme (Admin)
# Beklenen: 201 Created -> Platform GUID (Örn: "ec8798dc-2c47-4301-8585-15c789d0e32e")
# NOT: Dönen GUID'yi yukarıdaki @PlatformId değişkenine yapıştırın.
POST {{Gateway_HostAddress}}/api/catalog/platforms
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "name": "HBO Max Global",
  "slug": "hbo-max-e2e",
  "logoUrl": "https://example.com/hbomax.png",
  "inactiveLogoUrl": "https://example.com/hbomax-off.png",
  "baseWebUrl": "https://www.hbomax.com",
  "baseAppSchemeUrl": "hbomax://",
  "displayOrder": 5,
  "isActive": true
}

### 🔴 3.3 Mükerrer Platform Slug Hatası (Conflict)
# Beklenen: 409 Conflict -> code: "PLATFORM_SLUG_ALREADY_EXISTS"
POST {{Gateway_HostAddress}}/api/catalog/platforms
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "name": "HBO Max Duplicate",
  "slug": "hbo-max-e2e",
  "logoUrl": "https://example.com/hbomax.png",
  "inactiveLogoUrl": "https://example.com/hbomax-off.png",
  "baseWebUrl": "https://www.hbomax.com",
  "baseAppSchemeUrl": "hbomax://",
  "displayOrder": 5,
  "isActive": true
}

### 🔴 3.4 Validasyon Hatası: Boş İsim (Validation Problem)
# Beklenen: 400 Bad Request -> RFC 7807 ProblemDetails
POST {{Gateway_HostAddress}}/api/catalog/platforms
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "name": "",
  "slug": "empty-slug-test",
  "logoUrl": "https://example.com/logo.png",
  "inactiveLogoUrl": "https://example.com/off.png",
  "baseWebUrl": "https://example.com",
  "displayOrder": 1,
  "isActive": true
}

### 🔴 3.5 Validasyon Hatası: Geçersiz Logo URL Formatı (Validation Problem)
# Beklenen: 400 Bad Request -> RFC 7807 ProblemDetails ('LogoUrl must be a valid HTTP or HTTPS URL.')
POST {{Gateway_HostAddress}}/api/catalog/platforms
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "name": "Invalid URL Test",
  "slug": "invalid-url-test",
  "logoUrl": "not-a-valid-http-url",
  "inactiveLogoUrl": "https://example.com/off.png",
  "baseWebUrl": "https://example.com",
  "displayOrder": 1,
  "isActive": true
}

### 🔴 3.6 Validasyon Hatası: Tehlikeli AppSchemeUrl (javascript:) (XSS / Injection Defense)
# Beklenen: 400 Bad Request -> RFC 7807 ProblemDetails ('BaseAppSchemeUrl must be a valid custom application scheme')
POST {{Gateway_HostAddress}}/api/catalog/platforms
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "name": "Dangerous Scheme Test",
  "slug": "danger-scheme-test",
  "logoUrl": "https://example.com/logo.png",
  "inactiveLogoUrl": "https://example.com/off.png",
  "baseWebUrl": "https://example.com",
  "baseAppSchemeUrl": "javascript:alert(1)",
  "displayOrder": 1,
  "isActive": true
}

### 🔴 3.7 Platform ID ile Tekil Getirme Denemesi (Endpoint Tasarımı)
# Beklenen: 405 Method Not Allowed (Taksonomiler tek tek sorgulanmaz, GET / listesinden çekilir)
GET {{Gateway_HostAddress}}/api/catalog/platforms/{{PlatformId}}
Authorization: Bearer {{GuestToken}}
Accept: application/json

### 🟢 3.6 Platform Güncelleme (Admin)
# Beklenen: 204 No Content (Önbellek geçersiz kılınır)
PUT {{Gateway_HostAddress}}/api/catalog/platforms/{{PlatformId}}
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "name": "Max (Rebranded)",
  "slug": "max-e2e",
  "logoUrl": "https://example.com/max.png",
  "inactiveLogoUrl": "https://example.com/max-off.png",
  "baseWebUrl": "https://www.max.com",
  "baseAppSchemeUrl": "max://watch",
  "displayOrder": 1
}

### 🟢 3.7 Platform Silme / Soft-Delete (Admin)
# Beklenen: 204 No Content
DELETE {{Gateway_HostAddress}}/api/catalog/platforms/{{PlatformId}}
Authorization: Bearer {{AdminToken}}

### 🔴 3.8 Olmayan Platformu Silme (Not Found)
# Beklenen: 404 Not Found -> code: "PLATFORM_NOT_FOUND"
DELETE {{Gateway_HostAddress}}/api/catalog/platforms/ffffffff-ffff-ffff-ffff-ffffffffffff
Authorization: Bearer {{AdminToken}}


