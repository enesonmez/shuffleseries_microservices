DELETE {{Gateway_HostAddress}}/api/catalog/series/{{SeriesId}}
Authorization: Bearer {{AdminToken}}

### 🔴 7.11 Silinmiş Diziyi Getirme (Soft-Delete Kontrolü)
# Beklenen: 404 Not Found -> code: "SERIES_NOT_FOUND"
GET {{Gateway_HostAddress}}/api/catalog/series/{{SeriesId}}
Authorization: Bearer {{GuestToken}}
Accept: application/json


###############################################################################
# 8. BÖLÜMLER (EPISODES CRUD & STANDALONE EDGE CASES)
###############################################################################

### 🟢 8.1 Yeni Bölüm Oluşturma (Admin)
# Beklenen: 201 Created -> Episode GUID
# NOT: Dönen GUID'yi yukarıdaki @EpisodeId değişkenine yapıştırın.
POST {{Gateway_HostAddress}}/api/catalog/episodes
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "seriesId": "{{SeriesId}}",
  "seasonNumber": 1,
  "episodeNumber": 1,
  "runtimeMinutes": 60,
  "stillUrl": "https://image.tmdb.org/t/p/original/s1e1.jpg",
  "languageCode": "tr",
  "title": "Sırlar ve Kayıplar",
  "overview": "Küçük bir çocuk ormanda gizemli bir şekilde kaybolur.",
  "isStandAlone": true,
  "imdbId": "tt6754321",
  "imdbRating": 8.5,
  "imdbVotes": 12000
}

### 🔴 8.2 Olmayan Diziye Bölüm Ekleme (Not Found)
# Beklenen: 404 Not Found -> code: "SERIES_NOT_FOUND"
POST {{Gateway_HostAddress}}/api/catalog/episodes
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "seriesId": "ffffffff-ffff-ffff-ffff-ffffffffffff",
  "seasonNumber": 1,
  "episodeNumber": 1,
  "runtimeMinutes": 45,
  "languageCode": "tr",
  "title": "Yetim Bölüm",
  "overview": "Olmayan diziye bağlı bölüm denemesi"
}

### 🔴 8.3 Validasyon Hatası: Boş Bölüm Başlığı
# Beklenen: 400 Bad Request -> "Bölüm başlığı boş olamaz."
POST {{Gateway_HostAddress}}/api/catalog/episodes
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "seriesId": "{{SeriesId}}",
  "seasonNumber": 1,
  "episodeNumber": 1,
  "runtimeMinutes": 45,
  "languageCode": "tr",
  "title": "",
  "overview": "Başlıksız bölüm"
}

### 🟢 8.4 Bölüm Detayı Getirme (Standard User)
# Beklenen: 200 OK -> EpisodeResponse
GET {{Gateway_HostAddress}}/api/catalog/episodes/{{EpisodeId}}
Authorization: Bearer {{GuestToken}}
Accept: application/json

### 🟢 8.5 Bölüm Güncelleme (Admin)
# Beklenen: 204 No Content
PUT {{Gateway_HostAddress}}/api/catalog/episodes/{{EpisodeId}}
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "seasonNumber": 1,
  "episodeNumber": 1,
  "runtimeMinutes": 62,
  "stillUrl": "https://image.tmdb.org/t/p/original/s1e1-v2.jpg",
  "isStandAlone": true,
  "imdbId": "tt6754321",
  "imdbRating": 8.8,
  "imdbVotes": 15000
}

### 🟢 8.6 Bölüm Silme / Soft-Delete (Admin)
# Beklenen: 204 No Content
DELETE {{Gateway_HostAddress}}/api/catalog/episodes/{{EpisodeId}}
Authorization: Bearer {{AdminToken}}

### 🔴 8.7 Silinmiş Bölümü Getirme (Soft-Delete Kontrolü)
# Beklenen: 404 Not Found -> code: "EPISODE_NOT_FOUND"
GET {{Gateway_HostAddress}}/api/catalog/episodes/{{EpisodeId}}
Authorization: Bearer {{GuestToken}}
Accept: application/json

### 🟢 8.8 Bölüme Yayın Platformu Bağlama / Deep Link (Admin)
# Beklenen: 204 No Content
POST {{Gateway_HostAddress}}/api/catalog/episodes/{{EpisodeId}}/platforms
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "platformId": "{{PlatformId}}",
  "webUrl": "https://www.netflix.com/watch/80100172",
  "appSchemeUrl": "nflx://watch/80100172"
}

### 🔴 8.8.1 Mükerrer Bölüm Platform Bağlantısı Hatası (Conflict)
# Beklenen: 409 Conflict -> code: "DUPLICATE_EPISODE_PLATFORM"
POST {{Gateway_HostAddress}}/api/catalog/episodes/{{EpisodeId}}/platforms
Authorization: Bearer {{AdminToken}}
Content-Type: application/json

{
  "platformId": "{{PlatformId}}",
  "webUrl": "https://www.netflix.com/watch/80100172",
  "appSchemeUrl": "nflx://watch/80100172"
}

### 🟢 8.9 Bölümden Yayın Platformu Bağlantısını Kaldırma (Admin)
# Beklenen: 204 No Content
DELETE {{Gateway_HostAddress}}/api/catalog/episodes/{{EpisodeId}}/platforms/{{PlatformId}}
Authorization: Bearer {{AdminToken}}

