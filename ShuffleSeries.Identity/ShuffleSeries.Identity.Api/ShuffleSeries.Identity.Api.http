@Identity_HostAddress = http://localhost:5011
@Gateway_HostAddress = http://localhost:5001

# Dynamic Tokens & IDs (Giriş veya kayıt sonrası buraya yapıştırılabilir)
@AccessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
@RefreshToken = your_refresh_token_here
@GuestUserId = 00000000-0000-0000-0000-000000000000

###############################################################################
# 1. SAĞLIK KONTROLLERİ (HEALTH PROBES)
###############################################################################

### 🟢 1.1 Liveness Probe (Identity API Ayakta mı?)
# Beklenen Sonuç: 200 OK -> {"status":"Healthy","type":"Liveness",...}
GET {{Identity_HostAddress}}/health/live
Accept: application/json

### 🟢 1.2 Readiness Probe (PostgreSQL, Vault, RabbitMQ Hazır mı?)
# Beklenen Sonuç: 200 OK -> {"status":"Healthy","type":"Readiness",...}
GET {{Identity_HostAddress}}/health/ready
Accept: application/json

### 🟢 1.3 Gateway Üzerinden Identity Liveness Probe
# Beklenen Sonuç: 200 OK -> Gateway üzerinden identity.api:8080/health/live
GET {{Gateway_HostAddress}}/identity-api/health/live
Accept: application/json

### 🟢 1.4 Gateway Üzerinden Identity Readiness Probe
# Beklenen Sonuç: 200 OK -> Gateway üzerinden identity.api:8080/health/ready
GET {{Gateway_HostAddress}}/identity-api/health/ready
Accept: application/json


###############################################################################
# 2. KULLANICI KAYDI (REGISTER)
###############################################################################

### 🟢 2.1 Başarılı Standart Kullanıcı Kaydı (POST - Happy Path)
# Beklenen Sonuç: 200 OK -> accessToken, refreshToken, userId, roles: ["Standard"], permissions: [...]
POST {{Identity_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "tester.e2e@shuffleseries.com",
  "password": "Password123!"
}

### 🔴 2.2 Kayıt Validasyon Hatası: Geçersiz E-posta (POST)
# Beklenen Sonuç: 400 Bad Request -> RFC 7807 Validation Problem Details
POST {{Identity_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "invalid-email-format",
  "password": "Password123!"
}

### 🔴 2.3 Kayıt Validasyon Hatası: Zayıf Şifre (POST)
# Beklenen Sonuç: 400 Bad Request -> RFC 7807 Validation Problem Details
POST {{Identity_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "weakpass@shuffleseries.com",
  "password": "123"
}

### 🔴 2.4 Kayıt Çakışma Hatası: Mükerrer E-posta (POST - Conflict)
# Beklenen Sonuç: 409 Conflict -> code: "USER_ALREADY_EXISTS"
POST {{Identity_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "tester.e2e@shuffleseries.com",
  "password": "Password123!"
}


###############################################################################
# 3. KİMLİK DOĞRULAMA (LOGIN)
###############################################################################

### 🟢 3.1 Başarılı Giriş (POST - Happy Path)
# Beklenen Sonuç: 200 OK -> accessToken, refreshToken, roles, permissions
# NOT: Buradan dönen accessToken ve refreshToken değerlerini yukarıdaki değişkenlere atayabilirsiniz.
POST {{Identity_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "tester.e2e@shuffleseries.com",
  "password": "Password123!"
}

### 🔴 3.2 Giriş Hatası: Hatalı Şifre (POST - Unauthorized)
# Beklenen Sonuç: 401 Unauthorized -> code: "INVALID_CREDENTIALS"
POST {{Identity_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "tester.e2e@shuffleseries.com",
  "password": "WrongPassword999!"
}

### 🔴 3.3 Giriş Hatası: Var Olmayan Kullanıcı (POST - Unauthorized)
# Beklenen Sonuç: 401 Unauthorized -> code: "INVALID_CREDENTIALS"
POST {{Identity_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "nonexistent.user@shuffleseries.com",
  "password": "Password123!"
}

### 🔴 3.4 Giriş Validasyon Hatası: Boş Alanlar (POST)
# Beklenen Sonuç: 400 Bad Request -> RFC 7807 Validation Problem Details
POST {{Identity_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "tester.e2e@shuffleseries.com",
  "password": ""
}


###############################################################################
# 4. PROFİL BİLGİSİ & YETKİLER (/ME)
###############################################################################

### 🟢 4.1 Profil Bilgilerini Getir (GET - Bearer Token ile)
# Beklenen Sonuç: 200 OK -> userId, email, roles, permissions, isGuest: false
GET {{Identity_HostAddress}}/api/auth/me
Authorization: Bearer {{AccessToken}}
Accept: application/json

### 🔴 4.2 Profil Bilgileri: Token Eksik (GET - RFC 7807 401 Unauthorized)
# Beklenen Sonuç: 401 Unauthorized -> code: "AUTH_UNAUTHORIZED" (ProblemDetails)
GET {{Identity_HostAddress}}/api/auth/me
Accept: application/json

### 🔴 4.3 Profil Bilgileri: Geçersiz/Bozuk Token (GET - RFC 7807 401 Unauthorized)
# Beklenen Sonuç: 401 Unauthorized -> code: "AUTH_UNAUTHORIZED" (ProblemDetails)
GET {{Identity_HostAddress}}/api/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.invalid.signature
Accept: application/json


###############################################################################
# 5. MİSAFİR OTURUMU (GUEST SESSION)
###############################################################################

### 🟢 5.1 Anonim Misafir Oturumu Oluştur (POST)
# Beklenen Sonuç: 200 OK -> isGuest: true, roles: ["Guest"], geçici accessToken ve refreshToken
POST {{Identity_HostAddress}}/api/auth/guest
Content-Type: application/json


###############################################################################
# 6. MİSAFİR HESABI KALICI HESABA DÖNÜŞTÜRME (CONVERT FROM GUEST)
###############################################################################

### 🟢 6.1 Misafir Hesabını Kalıcı Hesaba Yükselt (POST - Happy Path)
# Beklenen Sonuç: 200 OK -> Aynı userId korunarak kalıcı e-posta/şifre atanır, Standard rol verilir, UserRegisteredEvent fırlatılır.
POST {{Identity_HostAddress}}/api/auth/convert-guest
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "email": "promoted.user@shuffleseries.com",
  "password": "NewPassword123!"
}

### 🔴 6.2 Standart Kullanıcıyı Dönüştürme Denemesi (POST - 422 Unprocessable Entity)
# Beklenen Sonuç: 422 Unprocessable Entity -> code: "USER_ALREADY_REGISTERED" (Business Rule Violation)
POST {{Identity_HostAddress}}/api/auth/convert-guest
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "email": "promoted.user@shuffleseries.com",
  "password": "NewPassword123!"
}

### 🔴 6.3 Misafir Dönüştürme: Token Eksik (POST - 401 Unauthorized)
# Beklenen Sonuç: 401 Unauthorized -> code: "AUTH_UNAUTHORIZED"
POST {{Identity_HostAddress}}/api/auth/convert-guest
Content-Type: application/json

{
  "email": "unauthorized.convert@shuffleseries.com",
  "password": "NewPassword123!"
}

### 🔴 6.4 Misafir Dönüştürme: Validasyon Hatası (POST - 400 Bad Request)
# Beklenen Sonuç: 400 Bad Request -> RFC 7807 Validation Problem Details
POST {{Identity_HostAddress}}/api/auth/convert-guest
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "123"
}

### 🔴 6.5 Misafir Dönüştürme: Mükerrer E-posta (POST - 409 Conflict)
# Beklenen Sonuç: 409 Conflict -> code: "USER_ALREADY_EXISTS"
POST {{Identity_HostAddress}}/api/auth/convert-guest
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "email": "tester.e2e@shuffleseries.com",
  "password": "NewPassword123!"
}


###############################################################################
# 7. REFRESH TOKEN ROTASYONU VE ÇALINMA TESPİTİ (OWASP API4)
###############################################################################

### 🟢 7.1 Refresh Token Rotasyonu (POST - Happy Path)
# Beklenen Sonuç: 200 OK -> Yeni accessToken ve YENİ bir refreshToken
POST {{Identity_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{RefreshToken}}"
}

### 🔴 7.2 İptal Edilmiş/Önceden Kullanılmış Token'ın Tekrar Sunulması (POST - Çalınma Tespiti)
# Beklenen Sonuç: 401 Unauthorized -> code: "TOKEN_REUSE_DETECTED"
# Mimari Koruma: Sistem tüm aktif oturumları anında iptal eder (Token Family Revocation).
POST {{Identity_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{RefreshToken}}"
}

### 🔴 7.3 Geçersiz / Uydurma Refresh Token (POST - Unauthorized)
# Beklenen Sonuç: 401 Unauthorized -> code: "INVALID_REFRESH_TOKEN"
POST {{Identity_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "completely_fake_refresh_token_xyz_123"
}


###############################################################################
# 8. TOKEN İPTALİ / ÇIKIŞ (REVOKE TOKEN)
###############################################################################

### 🟢 8.1 Aktif Refresh & Access Token'ı İptal Et (POST - Logout & Redis Blacklist)
# Beklenen Sonuç: 204 No Content (Refresh token DB'de iptal edilir, AccessToken jti Redis kara listesine eklenir)
POST {{Identity_HostAddress}}/api/auth/revoke
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "refreshToken": "{{RefreshToken}}",
  "accessToken": "{{AccessToken}}"
}

### 🔴 8.2 Sistemde Olmayan Token'ı İptal Etmeye Çalışma (POST - Not Found)
# Beklenen Sonuç: 404 Not Found -> code: "TOKEN_NOT_FOUND"
POST {{Identity_HostAddress}}/api/auth/revoke
Content-Type: application/json

{
  "refreshToken": "non_existent_refresh_token_abc_999"
}


###############################################################################
# 9. HESAP SİLME (GDPR / APPLE 5.1.1(v) SOFT DELETE & REDIS BLACKLIST)
###############################################################################

### 🔴 9.1 Hesap Silme: Token Olmadan Çağırma (DELETE - 401)
# Beklenen Sonuç: 401 Unauthorized -> code: "AUTH_UNAUTHORIZED"
DELETE {{Identity_HostAddress}}/api/auth/account
Accept: application/json

### 🟢 9.2 Kendi Hesabını Sil (DELETE - Bearer Token ile)
# Beklenen Sonuç: 204 No Content (Hesap IsDeleted=true yapılır, tüm oturumlar Redis'e blacklist eklenir, Outbox eventi atılır)
DELETE {{Identity_HostAddress}}/api/auth/account
Authorization: Bearer {{AccessToken}}

### 🔴 9.3 Zaten Silinmiş Hesabın Belirteciyle İstek Yapma (DELETE - 401 Revoked)
# Beklenen Sonuç: 401 Unauthorized -> code: "AUTH_TOKEN_REVOKED" (Kullanıcının belirteçleri Redis kara listesinde)
DELETE {{Identity_HostAddress}}/api/auth/account
Authorization: Bearer {{AccessToken}}


###############################################################################
# 10. YARP API GATEWAY ÜZERİNDEN ROTER VE REDIS TOKEN BLACKLIST GÜVENLİK TESTİ
###############################################################################

### 🔴 10.1 API Gateway Üzerinden /api/auth/me Çağrısı (Token Eksik - 401)
# Beklenen Sonuç: 401 Unauthorized -> Gateway isteği doğrular ve 401 AUTH_UNAUTHORIZED döner.
GET {{Gateway_HostAddress}}/api/auth/me
Accept: application/json

### 🟢 10.2 API Gateway Üzerinden /api/auth/me Çağrısı (Geçerli Bearer Token ile - 200 OK)
# Beklenen Sonuç: 200 OK -> Gateway token doğrulaması ve Redis Blacklist kontrolünden geçer.
GET {{Gateway_HostAddress}}/api/auth/me
Authorization: Bearer {{AccessToken}}
Accept: application/json

### 🔴 10.3 API Gateway Üzerinden İptal Edilmiş (Revoked) Token ile Çağrı (401 AUTH_TOKEN_REVOKED)
# Beklenen Sonuç: 401 Unauthorized -> code: "AUTH_TOKEN_REVOKED", Title: "Token Revoked"
# Açıklama: İptal edilen token Gateway seviyesinde OnTokenValidated hook'u ile Redis'ten yakalanır, downstream'e iletilmez!
GET {{Gateway_HostAddress}}/api/auth/me
Authorization: Bearer {{AccessToken}}
Accept: application/json


###############################################################################
# 11. SOSYAL KİMLİK DOĞRULAMA (SOCIAL LOGIN - GOOGLE / APPLE SSO)
###############################################################################

### 🟢 11.1 Google SSO ile Giriş (POST - Happy Path)
# Beklenen Sonuç: 200 OK -> accessToken, refreshToken, roles, permissions, isGuest: false
POST {{Identity_HostAddress}}/api/auth/social-login
Content-Type: application/json

{
  "provider": "Google",
  "idToken": "mock_google_id_token:social_user@gmail.com"
}

### 🟢 11.2 Apple SSO ile Giriş (POST - Happy Path)
# Beklenen Sonuç: 200 OK -> accessToken, refreshToken, roles, permissions, isGuest: false
POST {{Identity_HostAddress}}/api/auth/social-login
Content-Type: application/json

{
  "provider": "Apple",
  "idToken": "mock_apple_id_token:apple_user@icloud.com",
  "appleRefreshToken": "mock_apple_refresh_token_123"
}

### 🔴 11.3 Desteklenmeyen Sağlayıcı ile Giriş (POST - 400 Bad Request)
# Beklenen Sonuç: 400 Bad Request -> RFC 7807 Validation Problem Details
POST {{Identity_HostAddress}}/api/auth/social-login
Content-Type: application/json

{
  "provider": "Facebook",
  "idToken": "mock_facebook_id_token"
}

### 🔴 11.4 Geçersiz Dış Sağlayıcı Belirteci ile Giriş (POST - 401 Unauthorized)
# Beklenen Sonuç: 401 Unauthorized -> code: "INVALID_EXTERNAL_TOKEN"
POST {{Identity_HostAddress}}/api/auth/social-login
Content-Type: application/json

{
  "provider": "Google",
  "idToken": "invalid_unverifiable_mock_token"
}


###############################################################################
# 12. PAROLA GÜNCELLEME (CHANGE PASSWORD)
###############################################################################

### 🟢 12.1 Parola Güncelleme (POST - Happy Path)
# Beklenen Sonuç: 204 No Content -> Şifre güncellenir, tüm oturumlar Redis kara listesine eklenir.
POST {{Identity_HostAddress}}/api/auth/change-password
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "currentPassword": "NewPassword123!",
  "newPassword": "UpdatedPassword456!"
}

### 🔴 12.2 Parola Güncelleme: Yanlış Mevcut Şifre (POST - 401 Unauthorized)
# Beklenen Sonuç: 401 Unauthorized -> code: "INVALID_CURRENT_PASSWORD"
POST {{Identity_HostAddress}}/api/auth/change-password
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "currentPassword": "WrongCurrentPassword123!",
  "newPassword": "UpdatedPassword456!"
}

### 🔴 12.3 Parola Güncelleme: Token Eksik (POST - 401 Unauthorized)
# Beklenen Sonuç: 401 Unauthorized -> code: "AUTH_UNAUTHORIZED"
POST {{Identity_HostAddress}}/api/auth/change-password
Content-Type: application/json

{
  "currentPassword": "CurrentPassword123!",
  "newPassword": "UpdatedPassword456!"
}

### 🔴 12.4 Parola Güncelleme: Zayıf Yeni Şifre (POST - 400 Bad Request)
# Beklenen Sonuç: 400 Bad Request -> RFC 7807 Validation Problem Details
POST {{Identity_HostAddress}}/api/auth/change-password
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "currentPassword": "CurrentPassword123!",
  "newPassword": "123"
}

### 🔴 12.5 Parola Güncelleme: Yeni Şifre Mevcut Şifre ile Aynı (POST - 400 Bad Request)
# Beklenen Sonuç: 400 Bad Request -> code: "ValidationFailure" ("New password must be different from current password.")
POST {{Identity_HostAddress}}/api/auth/change-password
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "currentPassword": "CurrentPassword123!",
  "newPassword": "CurrentPassword123!"
}

