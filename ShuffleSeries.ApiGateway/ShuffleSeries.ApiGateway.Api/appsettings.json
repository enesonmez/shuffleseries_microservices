{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Vault": {
    "Enabled": true,
    "MountPoint": "secret",
    "Optional": true
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "catalog-openapi-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog-api/openapi/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/catalog-api" }
        ]
      },
      "catalog-health-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog-api/health/live"
        },
        "Transforms": [
          { "PathRemovePrefix": "/catalog-api" }
        ]
      },
      "auth-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "StrictLimiter",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-openapi-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity-api/openapi/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity-api" }
        ]
      },
      "identity-health-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity-api/health/live"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity-api" }
        ]
      },
      "shuffle-route": {
        "ClusterId": "shuffle-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/shuffle/{**catch-all}"
        }
      },
      "shuffle-openapi-route": {
        "ClusterId": "shuffle-cluster",
        "Match": {
          "Path": "/shuffle-api/openapi/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/shuffle-api" }
        ]
      },
      "shuffle-health-route": {
        "ClusterId": "shuffle-cluster",
        "Match": {
          "Path": "/shuffle-api/health/live"
        },
        "Transforms": [
          { "PathRemovePrefix": "/shuffle-api" }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://catalog.api:8080" 
          }
        }
      },
      "identity-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://identity.api:8080"
          }
        }
      },
      "shuffle-cluster": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://shuffleengine.api:8080"
          }
        }
      }
    }
  }
}
