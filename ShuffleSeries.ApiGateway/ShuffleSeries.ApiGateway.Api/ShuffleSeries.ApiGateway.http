@PremiumToken = eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9..dxCVidRviLsQygsCfs0in0VJgYT8XU94DlH56WwaBUA
@StandardToken = eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9..mn5FY_tTubGKwkGSxQcSUZIAQvK2dGjqaq7eiCZMv6I
@GuestToken = eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9..Pshui97PU2B6F3wUdz_dqsVIirc5K_pJqKcri_wjxfw
@ExpiredToken = eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9..igC0IDWy79JmJhglIkvUkyh_fsqywKGqvedPJtottN4
@TamperedToken = eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9..Nhw1md9Itca-KmHWb1x6z93BJw_R4M4WaHoo5xhyVY8

###############################################################################
# 1. API GATEWAY SAĞLIK KONTROLLERİ (HEALTH PROBES)
###############################################################################

### 🟢 1.1 API Gateway Kendi Sağlığı (Liveness Probe)
# Beklenen: 200 OK -> {"status":"Healthy","type":"Liveness",...}
GET {{Gateway_HostAddress}}/health/live
Accept: application/json

### 🟢 1.2 API Gateway Kendi Sağlığı (Readiness Probe)
# Beklenen: 200 OK -> {"status":"Healthy","type":"Readiness",...}
GET {{Gateway_HostAddress}}/health/ready
Accept: application/json

### 🟢 1.3 Catalog Mikroservisi Sağlığı (Gateway YARP Üzerinden - Liveness)
# Beklenen: 200 OK -> YARP reverse proxy üzerinden catalog /health/live
GET {{Gateway_HostAddress}}/catalog-api/health/live
Accept: application/json

### 🟢 1.4 Catalog Mikroservisi Sağlığı (Gateway YARP Üzerinden - Readiness)
# Beklenen: 200 OK -> YARP reverse proxy üzerinden catalog /health/ready
GET {{Gateway_HostAddress}}/catalog-api/health/ready
Accept: application/json

### 🟢 1.5 Identity Mikroservisi Sağlığı (Gateway YARP Üzerinden - Liveness)
# Beklenen: 200 OK -> YARP reverse proxy üzerinden identity /health/live
GET {{Gateway_HostAddress}}/identity-api/health/live
Accept: application/json

### 🟢 1.6 Identity Mikroservisi Sağlığı (Gateway YARP Üzerinden - Readiness)
# Beklenen: 200 OK -> YARP reverse proxy üzerinden identity /health/ready
GET {{Gateway_HostAddress}}/identity-api/health/ready
Accept: application/json


###############################################################################
# 2. MERKEZİ OPENAPI / SWAGGER DOKÜMANTASYON AGGREGATION
###############################################################################

### 🟢 2.1 Catalog OpenAPI v3 JSON Spesifikasyonu
# Beklenen: 200 OK -> Catalog servisinin OpenAPI spesifikasyonu
GET {{Gateway_HostAddress}}/catalog-api/openapi/v1.json
Accept: application/json

### 🟢 2.2 Identity OpenAPI v3 JSON Spesifikasyonu
# Beklenen: 200 OK -> Identity servisinin OpenAPI spesifikasyonu
GET {{Gateway_HostAddress}}/identity-api/openapi/v1.json
Accept: application/json


###############################################################################
# 3. YARP REVERSE PROXY ROUTING KONTROLLERİ
###############################################################################

### 🟢 3.1 Catalog Platformlar Listesi Proxy
GET {{Gateway_HostAddress}}/api/catalog/platforms
Authorization: Bearer {{GuestToken}}
Accept: application/json

### 🟢 3.2 Catalog Modlar Listesi Proxy
GET {{Gateway_HostAddress}}/api/catalog/moods?lang=tr
Authorization: Bearer {{GuestToken}}
Accept: application/json

### 🟢 3.3 Catalog Türler Listesi Proxy
GET {{Gateway_HostAddress}}/api/catalog/genres?lang=tr
Authorization: Bearer {{GuestToken}}
Accept: application/json

### 🟢 3.4 Catalog Sayfalanmış Dizi Listesi Proxy
GET {{Gateway_HostAddress}}/api/catalog/series?page=1&pageSize=5
Authorization: Bearer {{GuestToken}}
Accept: application/json

### 🟢 3.5 Identity Anonim Misafir Oturumu Proxy
POST {{Gateway_HostAddress}}/api/auth/guest
Content-Type: application/json

### 🔴 3.6 Tanımlı Olmayan Downstream Route -> 404 Not Found
GET {{Gateway_HostAddress}}/api/nonexistent/route/xyz
Accept: application/json

### 🔴 3.7 Gateway Tarafında Hiç Tanımlanmamış Path -> 404 Not Found
GET {{Gateway_HostAddress}}/totally/unknown/path
Accept: application/json


###############################################################################
# 4. DAĞITIK İZLEME (DISTRIBUTED TRACING & CORRELATION ID)
###############################################################################

### 🟢 4.1 İstemci Özel X-Correlation-ID Başlığı Gönderdiğinde Response'ta Aynen Korunur
# Beklenen: Response headers içinde 'X-Correlation-ID: custom-client-trace-12345' döner.
GET {{Gateway_HostAddress}}/health/live
X-Correlation-ID: custom-client-trace-12345
Accept: application/json

### 🟢 4.2 X-Correlation-ID Gönderilmediğinde Gateway Tarafından Otomatik Üretilir
# Beklenen: Response headers içinde en az 32 karakterlik GUID 'X-Correlation-ID' döner.
GET {{Gateway_HostAddress}}/health/live
Accept: application/json


###############################################################################
# 5. MERKEZİ CORS (CROSS-ORIGIN RESOURCE SHARING) PREFLIGHT
###############################################################################

### 🟢 5.1 OPTIONS Preflight Talebi (CORS Doğrulaması)
# Beklenen: 204 No Content -> Access-Control-Allow-Origin, Access-Control-Allow-Methods, Access-Control-Allow-Headers döner.
OPTIONS {{Gateway_HostAddress}}/api/catalog/platforms
Origin: http://localhost:3000
Access-Control-Request-Method: GET
Access-Control-Request-Headers: Authorization,Content-Type,X-Correlation-ID

### 🟢 5.2 Origin Başlığı ile Basit GET İsteği
# Beklenen: 200 OK -> Access-Control-Allow-Origin başlığı içerir.
GET {{Gateway_HostAddress}}/health/live
Origin: http://localhost:3000
Accept: application/json


###############################################################################
# 6. GATEWAY SEVİYESİNDE ROL TABANLI YETKİLENDİRME (RBAC POLICY ENFORCEMENT)
# Hedef: /api/shuffle/vip-weekend (Gateway appsettings'te RequirePremiumRole ile korunur)
###############################################################################

### 🔴 6.1 Token Olmadan VIP Rotaya Erişim -> 401 Unauthorized (AUTH_UNAUTHORIZED)
# Beklenen: 401 Unauthorized -> code: "AUTH_UNAUTHORIZED" (Downstream'e iletilmeden Gateway sınırında engellenir)
GET {{Gateway_HostAddress}}/api/shuffle/vip-weekend
Accept: application/json

### 🔴 6.2 Geçersiz / Bozuk Token ile VIP Rotaya Erişim -> 401 Unauthorized
GET {{Gateway_HostAddress}}/api/shuffle/vip-weekend
Authorization: Bearer not_a_valid_jwt_token_string
Accept: application/json

### 🔴 6.3 Süresi Dolmuş (Expired) Token ile VIP Rotaya Erişim -> 401 Unauthorized
GET {{Gateway_HostAddress}}/api/shuffle/vip-weekend
Authorization: Bearer {{ExpiredToken}}
Accept: application/json

### 🔴 6.4 İmzası Değiştirilmiş (Tampered) Token ile VIP Rotaya Erişim -> 401 Unauthorized
GET {{Gateway_HostAddress}}/api/shuffle/vip-weekend
Authorization: Bearer {{TamperedToken}}
Accept: application/json

### 🔴 6.5 Standard Rolü ile VIP Rotaya Erişim -> 403 Forbidden (AUTH_FORBIDDEN)
# Beklenen: 403 Forbidden -> code: "AUTH_FORBIDDEN" (RequirePremiumRole kuralı Gateway seviyesinde denetlenir)
GET {{Gateway_HostAddress}}/api/shuffle/vip-weekend
Authorization: Bearer {{StandardToken}}
Accept: application/json

### 🔴 6.6 Guest Rolü ile VIP Rotaya Erişim -> 403 Forbidden (AUTH_FORBIDDEN)
GET {{Gateway_HostAddress}}/api/shuffle/vip-weekend
Authorization: Bearer {{GuestToken}}
Accept: application/json

### 🟢 6.7 Premium Rolü ile VIP Rotaya Erişim -> Auth Başarılı (200 veya 502 Downstream)
# Beklenen: Yetkilendirme Gateway sınırında başarıyla geçer, istek shuffle servisine yönlendirilir.
GET {{Gateway_HostAddress}}/api/shuffle/vip-weekend
Authorization: Bearer {{PremiumToken}}
Accept: application/json


###############################################################################
# 7. REDIS TOKEN VE OTURUM KARA LİSTESİ (EDGE BLACKLIST ENFORCEMENT)
###############################################################################

### 🔴 7.1 Redis Kara Listesine Alınmış Token ile İstek (401 AUTH_TOKEN_REVOKED)
# Test Adımı: Redis CLI'dan aşağıdaki komut ile token jti kara listeye alınır:
# docker exec shuffleseries_redis redis-cli -a SuperSecretRedisPassword2026!! SET "shuffleseries:blacklist:token:e2e-gateway-admin-001" "revoked" EX 60
# Beklenen Sonuç: 401 Unauthorized -> code: "AUTH_TOKEN_REVOKED", title: "Token Revoked"
GET {{Gateway_HostAddress}}/api/auth/me
Authorization: Bearer {{AdminToken}}
Accept: application/json


###############################################################################
# 8. SIKI HIZ SINIRLANDIRMASI (STRICTLIMITER - 429 TOO MANY REQUESTS)
# Hedef: /api/auth/{**catch-all} (1 saniyede en fazla 5 isteğe izin verir)
###############################################################################

### 🟢 8.1 Kota İçi Normal İstek (1. İstek)
POST {{Gateway_HostAddress}}/api/auth/guest
Content-Type: application/json

### 🟢 8.2 Kota İçi Hızlı İstek (2. İstek)
POST {{Gateway_HostAddress}}/api/auth/guest
Content-Type: application/json

### 🟢 8.3 Kota İçi Hızlı İstek (3. İstek)
POST {{Gateway_HostAddress}}/api/auth/guest
Content-Type: application/json

### 🟢 8.4 Kota İçi Hızlı İstek (4. İstek)
POST {{Gateway_HostAddress}}/api/auth/guest
Content-Type: application/json

### 🟢 8.5 Kota İçi Hızlı İstek (5. İstek)
POST {{Gateway_HostAddress}}/api/auth/guest
Content-Type: application/json

### 🔴 8.6 Kota Aşımı (6. İstek - 1 saniye dolmadan gönderilirse) -> 429 Too Many Requests
# Beklenen: 429 Too Many Requests (StrictLimiter PermitLimit = 5 aşıldığında Gateway anında engeller)
POST {{Gateway_HostAddress}}/api/auth/guest
Content-Type: application/json
