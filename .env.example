# ==============================================================================
# ShuffleSeries - Local Development Environment Variables
# ==============================================================================
# Bu dosya, yerel geliştirme ortamında Docker Compose servislerinin
# yapılandırılması için referans şablondur.
# Kendi yerel kopyanızı oluşturmak için:
#   cp .env.example .env
# ==============================================================================

# --- PostgreSQL (Relational Database - Catalog, Identity, Outbox) ---
POSTGRES_DB_USER=admin
POSTGRES_DB_PASSWORD=SuperSecretSecurePassword2026!!
POSTGRES_DB_NAME=shuffleseries_db
POSTGRES_MULTIPLE_DATABASES=shuffleseries_identity

# --- MongoDB (NoSQL Document Store - History & Analytics) ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=SuperSecretMongoPassword2026!!
MONGO_INITDB_DATABASE=shuffleseries_history

# --- Redis (In-Memory Key/Value - Caching, Shuffle Store, Blacklist) ---
REDIS_PASSWORD=SuperSecretRedisPassword2026!!

# --- RabbitMQ (Message Broker - Event-Driven Architecture) ---
RABBITMQ_USER=guest_123
RABBITMQ_PASSWORD=guest_123

# --- HashiCorp Vault (Sır Yönetimi & Secrets Engine) ---
VAULT_ADDR=http://localhost:8200
VAULT_ROOT_TOKEN=root

# --- SonarQube (Kod Kalitesi ve Statik Kod Analizi) ---
SONARQUBE_DB_USER=sonar
SONARQUBE_DB_PASSWORD=sonar
SONARQUBE_DB_NAME=sonarqube
