# ==============================================================================
# ShuffleSeries - Local Development Environment Variables (Single Source of Truth)
# ==============================================================================
# Bu dosya, tüm mikroservisler, altyapı container'ları (Docker Compose) ve
# HashiCorp Vault için TEK GERÇEKLİK KAYNAĞIDIR (Single Source of Truth).
#
# Kendi yerel kopyanızı oluşturmak için:
#   cp .env.example .env
# ==============================================================================

# --- PostgreSQL (Relational Database - Catalog, Identity, Outbox) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_USER=admin
POSTGRES_DB_PASSWORD=SuperSecretSecurePassword2026!!
POSTGRES_DB_NAME=shuffleseries_db
POSTGRES_IDENTITY_DB_NAME=shuffleseries_identity
POSTGRES_MULTIPLE_DATABASES=shuffleseries_identity

# --- MongoDB (NoSQL Document Store - History & Analytics) ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=SuperSecretMongoPassword2026!!
MONGO_INITDB_DATABASE=shuffleseries_history

# --- Redis (In-Memory Key/Value - Caching, Shuffle Store, Token Blacklist) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=SuperSecretRedisPassword2026!!
REDIS_INSTANCE_NAME=shuffleseries:

# --- RabbitMQ (Message Broker - Event-Driven Architecture) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest_123
RABBITMQ_PASSWORD=guest_123

# --- HashiCorp Vault (Sır Yönetimi & Secrets Engine) ---
VAULT_ADDR=http://localhost:8200
VAULT_ROOT_TOKEN=root

# --- JWT Authentication & Token Security (Shared Secret & Token Policy) ---
JWT_SECRET=SuperSecretSecretKeyForJwtAuthenticationTokens2026!!
JWT_ISSUER=ShuffleSeries.Identity
JWT_AUDIENCE=ShuffleSeries.Microservices
JWT_EXPIRATION_MINUTES=60

# --- External Social Auth (Google & Apple OAuth Client IDs) ---
EXTERNAL_AUTH_VALIDATE_SIGNATURES=false
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- Centralized CORS Policy ---
CORS_ALLOWED_ORIGINS=*

# --- Observability & Telemetry (OpenTelemetry, Logging Sinks) ---
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOGGING_CONSOLE_ENABLED=true
LOGGING_CONSOLE_JSON=true
LOGGING_FILE_ENABLED=false
LOGGING_POSTGRESQL_ENABLED=false

# --- SonarQube (Kod Kalitesi ve Statik Kod Analizi) ---
SONARQUBE_DB_USER=sonar
SONARQUBE_DB_PASSWORD=sonar
SONARQUBE_DB_NAME=sonarqube
